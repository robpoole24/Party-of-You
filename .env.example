# ═══════════════════════════════════════════════════════════════
# PLATFORM ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git. It is in .gitignore.
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────
# CORE APP
# ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-another-long-random-string

# ─────────────────────────────────────────────────
# DATABASE
# Railway auto-sets this when you add a PostgreSQL plugin
# ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────
# FREE APIs — SIGN UP AND FILL IN NOW
# ─────────────────────────────────────────────────

# 1. Google Civic Information API
# Signup: https://console.cloud.google.com/apis/library/civicinfo.googleapis.com
GOOGLE_CIVIC_API_KEY=

# Also grab these from the same Google Cloud console:
GOOGLE_MAPS_API_KEY=

# 2. US Census Bureau API
# Signup: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# 3. VoteHub Polling API (currently open beta — no key required, but add when available)
# Signup: https://votehub.com/polls/api/
VOTEHUB_API_KEY=

# 4. FEC.gov API (Federal Election Commission)
# Signup: https://api.open.fec.gov/developers/
FEC_API_KEY=

# 5. ProPublica Congress API
# Signup: https://www.propublica.org/datastore/api/propublica-congress-api
PROPUBLICA_API_KEY=

# 6. OpenStates / Plural Policy API
# Signup: https://open.pluralpolicy.com/accounts/signup/
OPENSTATES_API_KEY=

# 7. OpenSecrets API
# Signup: https://www.opensecrets.org/api/admin/index.php?function=signup
OPENSECRETS_API_KEY=

# ─────────────────────────────────────────────────
# PAID APIs — ADD WHEN ACCESS IS GRANTED
# ─────────────────────────────────────────────────

# 8. Ballotpedia API
# Contact: data@ballotpedia.org | Est. cost: $5k–$25k/year
# Leave blank until access granted — system routes around it
BALLOTPEDIA_API_KEY=

# 9. Democracy Works Elections API
# Contact: https://data.democracy.works/request-pricing
DEMOCRACY_WORKS_API_KEY=

# 10. BallotReady API
# Contact: https://www.ballotready.org/our-data/
BALLOTREADY_API_KEY=

# ─────────────────────────────────────────────────
# COMMUNICATIONS
# ─────────────────────────────────────────────────

# 11. Twilio SMS
# Signup: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# 12. SendGrid Email
# Signup: https://signup.sendgrid.com/
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ─────────────────────────────────────────────────
# STORAGE
# ─────────────────────────────────────────────────

# 13. Cloudflare R2
# Signup: https://dash.cloudflare.com/sign-up
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=platform-assets

# ─────────────────────────────────────────────────
# FEATURE FLAGS — TOGGLE MODULES ON/OFF
# Set to 'true' when the module is ready and its APIs are connected
# ─────────────────────────────────────────────────
FEATURE_POLLING_INTELLIGENCE=false
FEATURE_BALLOT_ACCESS_GUIDE=false
FEATURE_CANDIDATE_WEBSITE=false
FEATURE_VOLUNTEER_PORTAL=false
FEATURE_EVENT_MANAGEMENT=false
FEATURE_VOTER_CONTACT_TOOLS=false
FEATURE_COMMUNICATIONS_SUITE=false
FEATURE_FEC_REPORTING=false
